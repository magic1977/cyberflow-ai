# Local development only. Copy this file to .env and replace every placeholder
# with a unique, randomly generated secret of at least 32 characters. Never commit .env.
POSTGRES_DB=cyberflow
POSTGRES_USER=cyberflow
POSTGRES_PASSWORD=replace-with-a-unique-random-32-character-password

N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace-with-a-unique-random-32-character-encryption-key
N8N_HOST=localhost
N8N_PROTOCOL=http
# Optional: set N8N_EDITOR_BASE_URL explicitly only when needed (e.g. reverse proxy); otherwise let docker-compose.yml default it from N8N_PORT
