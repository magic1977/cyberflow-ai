      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH input_data AS (\n    SELECT\n        $1::text AS external_id,\n        $2::text AS title,\n        $3::text AS url,\n        $4::timestamptz AS published_at,\n        $5::text AS raw_summary,\n        $6::text AS processing_status\n),\ninserted AS (\n    INSERT INTO cyber_articles (\n        source_id,\n        external_id,\n        title,\n        url,\n        published_at,\n        raw_summary,\n        processing_status,\n        updated_at\n    )\n    SELECT\n        (SELECT id FROM cyber_sources WHERE name = 'BleepingComputer' LIMIT 1),\n        external_id,\n        title,\n        url,\n        published_at,\n        raw_summary,\n        processing_status,\n        NOW()\n    FROM input_data\n    ON CONFLICT (url) DO NOTHING\n    RETURNING id, external_id, title, url\n)\nSELECT\n    id,\n    external_id,\n    title,\n    url,\n    TRUE AS is_new\nFROM inserted\n\nUNION ALL\n\nSELECT\n    ca.id,\n    ca.external_id,\n    ca.title,\n    ca.url,\n    FALSE AS is_new\nFROM cyber_articles ca\nJOIN input_data i ON ca.url = i.url\nWHERE NOT EXISTS (SELECT 1 FROM inserted);",
